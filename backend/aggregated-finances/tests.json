{
  "tests": [
    {
      "name": "OPTIONS request for CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET without parameters",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "GET aggregated finances without token returns 401",
      "method": "GET",
      "path": "/?period_start=2025-10-16&period_end=2025-10-31",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Invalid token returns 401",
      "method": "GET",
      "path": "/?period_start=2025-10-16&period_end=2025-10-31",
      "headers": {"X-Auth-Token": "invalid-token-12345"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}
