{
  "tests": [
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Password change without token returns 401",
      "method": "POST",
      "path": "/",
      "body": {"action": "change_password", "old_password": "x", "new_password": "yyyyyy"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Foreign email in body is ignored without token",
      "method": "POST",
      "path": "/",
      "body": {"action": "upload_avatar", "email": "director@example.com", "image": "x"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Invalid token returns 401",
      "method": "POST",
      "path": "/",
      "headers": {"X-Auth-Token": "invalid-token-12345"},
      "body": {"action": "get_profile"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}
