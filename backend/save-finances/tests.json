{
  "tests": [
    {
      "name": "OPTIONS CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Load finances without token returns 401",
      "method": "GET",
      "path": "/?modelId=1",
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Save finances without token returns 401",
      "method": "POST",
      "path": "/",
      "body": {"modelId": 1, "data": []},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Invalid token returns 401",
      "method": "GET",
      "path": "/?modelId=1",
      "headers": {"X-Auth-Token": "invalid-token-12345"},
      "expectedStatus": 401,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}
