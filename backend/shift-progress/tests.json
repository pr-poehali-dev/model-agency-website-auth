{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Missing params",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400
    },
    {
      "name": "Foreign progress without token is denied",
      "method": "GET",
      "path": "/?user_email=Dir@mba.com&role=director&period_start=2025-01-01&period_end=2025-01-15",
      "expectedStatus": 401
    },
    {
      "name": "Invalid token is denied",
      "method": "GET",
      "path": "/?user_email=Dir@mba.com&role=director&period_start=2025-01-01&period_end=2025-01-15",
      "headers": {"X-Auth-Token": "invalid-token-value"},
      "expectedStatus": 401
    }
  ]
}
