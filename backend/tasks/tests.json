{
  "tests": [
    {
      "name": "GET tasks without token returns 401",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401
    },
    {
      "name": "Fake director role header is rejected",
      "method": "GET",
      "path": "/",
      "headers": {
        "X-User-Email": "hacker@test.com",
        "X-User-Role": "director"
      },
      "expectedStatus": 401
    },
    {
      "name": "Invalid token returns 401",
      "method": "GET",
      "path": "/",
      "headers": {
        "X-Auth-Token": "invalid-token-12345"
      },
      "expectedStatus": 401
    },
    {
      "name": "OPTIONS CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    }
  ]
}
